<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur10e_robot">

    <!-- GROUPS: Representation of a set of joints and links. -->
    <group name="manipulator">
        <chain base_link="base_link" tip_link="qbhand_end_effector_link" />
    </group>

    <group name="qbhand_gripper">
        <link name="qbhand_base_link" />
        <link name="qbhand_palm_link" />
        <!-- Thumb -->
        <link name="qbhand_thumb_knuckle_link" />
        <link name="qbhand_thumb_proximal_link" />
        <link name="qbhand_thumb_distal_link" />
        <!-- Index -->
        <link name="qbhand_index_knuckle_link" />
        <link name="qbhand_index_proximal_link" />
        <link name="qbhand_index_middle_link" />
        <link name="qbhand_index_distal_link" />
        <!-- Middle -->
        <link name="qbhand_middle_knuckle_link" />
        <link name="qbhand_middle_proximal_link" />
        <link name="qbhand_middle_middle_link" />
        <link name="qbhand_middle_distal_link" />
        <!-- Ring -->
        <link name="qbhand_ring_knuckle_link" />
        <link name="qbhand_ring_proximal_link" />
        <link name="qbhand_ring_middle_link" />
        <link name="qbhand_ring_distal_link" />
        <!-- Little -->
        <link name="qbhand_little_knuckle_link" />
        <link name="qbhand_little_proximal_link" />
        <link name="qbhand_little_middle_link" />
        <link name="qbhand_little_distal_link" />

        <joint name="qbhand_synergy_joint" />
    </group>

    <!-- GROUP STATES -->
    <group_state name="home" group="manipulator">
        <joint name="shoulder_pan_joint" value="0" />
        <joint name="shoulder_lift_joint" value="-1.5708" />
        <joint name="elbow_joint" value="1.5708" />
        <joint name="wrist_1_joint" value="-1.5708" />
        <joint name="wrist_2_joint" value="-1.5708" />
        <joint name="wrist_3_joint" value="0" />
    </group_state>


    <!-- END EFFECTOR -->
    <end_effector name="qbhand_ee" parent_link="wrist_3_link" group="qbhand_gripper" parent_group="manipulator" />

    <!-- PASSIVE JOINTS -->
    <!-- Define the mimicked phalanx joints as passive so MoveIt ignores them for direct planning -->
    <passive_joint name="qbhand_thumb_knuckle_joint" />
    <passive_joint name="qbhand_thumb_proximal_joint" />
    <passive_joint name="qbhand_thumb_distal_joint" />
    <passive_joint name="qbhand_index_knuckle_joint" />
    <passive_joint name="qbhand_index_proximal_joint" />
    <passive_joint name="qbhand_index_middle_joint" />
    <passive_joint name="qbhand_index_distal_joint" />
    <!-- (Add the rest of the passive finger joints here for middle, ring, and little) -->

    <!-- DISABLE COLLISIONS -->
    <!-- By default, adjacent links are constantly colliding in collision checking. We must disable them. -->

    <!-- 1. Disable collisions between the robot wrist and the qbhand base -->
    <disable_collisions link1="wrist_3_link" link2="qbhand_base_link" reason="Adjacent" />
    <disable_collisions link1="wrist_2_link" link2="qbhand_base_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="qbhand_palm_link" reason="Default" />

    <!-- 2. Disable internal qbhand base/palm collisions -->
    <disable_collisions link1="qbhand_base_link" link2="qbhand_palm_link" reason="Adjacent" />

    <!-- 3. Disable adjacent phalanx collisions for all fingers -->
    <!-- Thumb -->
    <disable_collisions link1="qbhand_palm_link" link2="qbhand_thumb_knuckle_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_thumb_knuckle_link" link2="qbhand_thumb_proximal_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_thumb_proximal_link" link2="qbhand_thumb_distal_link" reason="Adjacent" />

    <!-- Index -->
    <disable_collisions link1="qbhand_palm_link" link2="qbhand_index_knuckle_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_index_knuckle_link" link2="qbhand_index_proximal_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_index_proximal_link" link2="qbhand_index_middle_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_index_middle_link" link2="qbhand_index_distal_link" reason="Adjacent" />

    <!-- Middle -->
    <disable_collisions link1="qbhand_palm_link" link2="qbhand_middle_knuckle_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_middle_knuckle_link" link2="qbhand_middle_proximal_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_middle_proximal_link" link2="qbhand_middle_middle_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_middle_middle_link" link2="qbhand_middle_distal_link" reason="Adjacent" />

    <!-- Ring -->
    <disable_collisions link1="qbhand_palm_link" link2="qbhand_ring_knuckle_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_ring_knuckle_link" link2="qbhand_ring_proximal_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_ring_proximal_link" link2="qbhand_ring_middle_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_ring_middle_link" link2="qbhand_ring_distal_link" reason="Adjacent" />

    <!-- Little -->
    <disable_collisions link1="qbhand_palm_link" link2="qbhand_little_knuckle_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_little_knuckle_link" link2="qbhand_little_proximal_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_little_proximal_link" link2="qbhand_little_middle_link" reason="Adjacent" />
    <disable_collisions link1="qbhand_little_middle_link" link2="qbhand_little_distal_link" reason="Adjacent" />

    <!-- 4. Prevent UR Arm links from reporting false collisions with themselves -->
    <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent" />
    <disable_collisions link1="base_link_inertia" link2="upper_arm_link" reason="Never" />
    <disable_collisions link1="base_link_inertia" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent" />
    <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent" />
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent" />
    <disable_collisions link1="shoulder_link" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="shoulder_link" link2="wrist_2_link" reason="Never" />
    <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent" />
    <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never" />
    <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent" />

        <disable_collisions link1="airskin_0" link2="base_link_inertia" reason="Never" />
    <disable_collisions link1="airskin_1" link2="base_link_inertia" reason="Never" />
    <disable_collisions link1="airskin_2" link2="base_link_inertia" reason="Never" />
    <disable_collisions link1="airskin_3" link2="base_link_inertia" reason="Never" />
    <disable_collisions link1="airskin_4" link2="base_link_inertia" reason="Never" />
    <disable_collisions link1="airskin_5" link2="base_link_inertia" reason="Never" />
    <disable_collisions link1="airskin_6" link2="base_link_inertia" reason="Never" />
    <disable_collisions link1="airskin_7" link2="base_link_inertia" reason="Never" />
    <disable_collisions link1="airskin_8" link2="base_link_inertia" reason="Never" />
    <disable_collisions link1="airskin_9" link2="base_link_inertia" reason="Never" />

    <disable_collisions link1="airskin_0" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_1" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_2" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_3" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_4" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_5" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_6" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_7" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_8" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_9" link2="shoulder_link" reason="Never" />

    <disable_collisions link1="airskin_0" link2="upper_arm_link" reason="Never" />
    <disable_collisions link1="airskin_1" link2="upper_arm_link" reason="Never" />
    <disable_collisions link1="airskin_2" link2="upper_arm_link" reason="Never" />
    <disable_collisions link1="airskin_3" link2="upper_arm_link" reason="Never" />
    <disable_collisions link1="airskin_4" link2="upper_arm_link" reason="Never" />
    <disable_collisions link1="airskin_5" link2="upper_arm_link" reason="Never" />
    <disable_collisions link1="airskin_6" link2="upper_arm_link" reason="Never" />
    <disable_collisions link1="airskin_7" link2="upper_arm_link" reason="Never" />
    <disable_collisions link1="airskin_8" link2="upper_arm_link" reason="Never" />
    <disable_collisions link1="airskin_9" link2="upper_arm_link" reason="Never" />

    <disable_collisions link1="airskin_0" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="airskin_1" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="airskin_2" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="airskin_3" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="airskin_4" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="airskin_5" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="airskin_6" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="airskin_7" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="airskin_8" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="airskin_9" link2="wrist_1_link" reason="Never" />

    <disable_collisions link1="airskin_0" link2="forearm_link" reason="Never" />
    <disable_collisions link1="airskin_1" link2="forearm_link" reason="Never" />
    <disable_collisions link1="airskin_2" link2="forearm_link" reason="Never" />
    <disable_collisions link1="airskin_3" link2="forearm_link" reason="Never" />
    <disable_collisions link1="airskin_4" link2="forearm_link" reason="Never" />
    <disable_collisions link1="airskin_5" link2="forearm_link" reason="Never" />
    <disable_collisions link1="airskin_6" link2="forearm_link" reason="Never" />
    <disable_collisions link1="airskin_7" link2="forearm_link" reason="Never" />
    <disable_collisions link1="airskin_8" link2="forearm_link" reason="Never" />
    <disable_collisions link1="airskin_9" link2="forearm_link" reason="Never" />

    <disable_collisions link1="airskin_0" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_1" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_2" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_3" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_4" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_5" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_6" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_7" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_8" link2="shoulder_link" reason="Never" />
    <disable_collisions link1="airskin_9" link2="shoulder_link" reason="Never" />

    <disable_collisions link1="airskin_0" link2="wrist_2_link" reason="Never" />
    <disable_collisions link1="airskin_1" link2="wrist_2_link" reason="Never" />
    <disable_collisions link1="airskin_2" link2="wrist_2_link" reason="Never" />
    <disable_collisions link1="airskin_3" link2="wrist_2_link" reason="Never" />
    <disable_collisions link1="airskin_4" link2="wrist_2_link" reason="Never" />
    <disable_collisions link1="airskin_5" link2="wrist_2_link" reason="Never" />
    <disable_collisions link1="airskin_6" link2="wrist_2_link" reason="Never" />
    <disable_collisions link1="airskin_7" link2="wrist_2_link" reason="Never" />
    <disable_collisions link1="airskin_8" link2="wrist_2_link" reason="Never" />
    <disable_collisions link1="airskin_9" link2="wrist_2_link" reason="Never" />

    <disable_collisions link1="airskin_0" link2="wrist_3_link" reason="Never" />
    <disable_collisions link1="airskin_1" link2="wrist_3_link" reason="Never" />
    <disable_collisions link1="airskin_2" link2="wrist_3_link" reason="Never" />
    <disable_collisions link1="airskin_3" link2="wrist_3_link" reason="Never" />
    <disable_collisions link1="airskin_4" link2="wrist_3_link" reason="Never" />
