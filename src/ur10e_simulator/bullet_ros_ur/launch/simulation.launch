<launch>
    <arg name="rviz" default="true"/>
    <arg name="gripper" default="true"/>


    <arg name="sim_config" default="$(eval 'ros_no_gripper.yaml' if str(arg('gripper')).lower() == 'false' else 'ros.yaml' if str(arg('gripper')).lower() == 'true' else 'ros_' + str(arg('gripper')) + '.yaml')" />
    <param name="gripper" value="$(arg gripper)"/>
    <param name="/bullet_ros/joint_names" value=""/>
    <param name="/bullet_ros/init_pos" value=""/>

    <param name="max_grip_width" value="$(eval 150 if str(arg('gripper')).lower() in ['true', 'false', 'rg6', '1', '0', ''] else 1)" />

    <arg name="urdf_file" value="$(eval 'ur10e.urdf' if str(arg('gripper')).lower() == 'false' else 'ur10e_rg6.urdf' if str(arg('gripper')).lower() == 'true' else 'ur10e_' + str(arg('gripper')).lower() + '.urdf')" />
    <param name="robot_description" textfile="$(find bullet_ros_ur)/urdf/$(arg urdf_file)"/>

    <include file="$(find ur10e_moveit_config)/launch/moveit_planning_execution.launch">
        <arg name="gripper" value="$(arg gripper)"/>
    </include>

    <!-- Launch RVIZ -->
    <include if="$(arg rviz)" file="$(find ur10e_moveit_config)/launch/moveit_rviz.launch"/>

      <!-- Load controller settings -->
    <group ns="robot">
            <!-- Control motion and compliance controller with one handle -->
            <remap from="motion_control_handle/target_frame" to="target_frame" />
            <remap from="cartesian_motion_controller/target_frame" to="target_frame" />
            <remap from="cartesian_compliance_controller/target_frame" to="target_frame" />

            <!-- Control wrenches via one topic -->
            <remap from="cartesian_force_controller/target_wrench" to="target_wrench" />
            <remap from="cartesian_force_controller/ft_sensor_wrench" to="wrench_compensated" />
            <remap from="cartesian_compliance_controller/target_wrench" to="target_wrench" />
            <remap from="cartesian_compliance_controller/ft_sensor_wrench" to="wrench" />

        <rosparam file="$(find bullet_ros_ur)/config/ur10e_controllers.yaml" command="load"/>
        <rosparam file="$(find bullet_ros_ur)/config/force_controllers.yaml" command="load"/>
        <remap to="/scaled_pos_joint_traj_controller/follow_joint_trajectory" from="/robot/scaled_pos_joint_traj_controller/follow_joint_trajectory"/>
        <remap to="/joint_group_vel_controller/command" from="/robot/joint_group_vel_controller/command"/>

         <arg name="running_controllers" default="joint_state_controller scaled_pos_joint_traj_controller "/>

        <node name="controller_spawner_main" pkg="controller_manager" type="spawner" respawn="false" output="screen"
              args="$(arg running_controllers)"/>

        <node name="controller_spawner_stopped" pkg="controller_manager" type="spawner" respawn="false" output="screen"
              args="--stopped joint_group_vel_controller motion_control_handle cartesian_motion_controller cartesian_force_controller cartesian_compliance_controller"/>

        <node name="bullet_ros_ur" type="bullet_ros_ur" pkg="bullet_ros_ur" output="screen"/>
    </group>

    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="true" output="screen" />
    <node if="$(eval str(arg('gripper')).lower() in ['true', 'false', 'rg6', '1'])" name="finger_tf_broadcaster" pkg="bullet_ros_ur" type="rg_finger_publisher.py" output="screen" />
    <node name="pyUR" pkg="bullet_ros_ur" type="main.py" output="screen" args="config=$(arg sim_config)"/>

    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" respawn="true" output="screen">
            <rosparam param="source_list">["/robot/joint_states", "/jaws/joint_states", "/finger/joint_states"]</rosparam>
            <rosparam param="rate">250</rosparam>
    </node>
</launch>